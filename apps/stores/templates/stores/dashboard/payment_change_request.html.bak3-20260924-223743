{% extends "stores/dashboard/base.html" %}

{% block title %}Solicitar cambio de datos bancarios{% endblock %}

{% block content %}
<style>
    .req-wrap { max-width: 700px; }
    .alert-box {
        background: #fef5e7;
        border-left: 4px solid #f39c12;
        padding: 14px 18px;
        border-radius: 8px;
        margin-bottom: 20px;
        font-size: 0.9rem;
        color: #856404;
        line-height: 1.5;
    }
    .alert-box strong { color: #b9770e; }
    .form-card {
        background: white;
        border-radius: 12px;
        padding: 24px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.06);
    }
    .form-card h2 {
        margin: 0 0 6px;
        font-size: 1.2rem;
        color: #1a1a2e;
    }
    .form-card .sub {
        font-size: 0.85rem;
        color: #7f8c8d;
        margin-bottom: 20px;
        line-height: 1.5;
    }
    .field {
        margin-bottom: 16px;
    }
    .field label {
        display: block;
        font-size: 0.85rem;
        font-weight: 600;
        color: #444;
        margin-bottom: 5px;
    }
    .field input,
    .field textarea {
        width: 100%;
        padding: 10px 14px;
        border: 2px solid #e1e5ea;
        border-radius: 8px;
        font-size: 0.92rem;
        font-family: inherit;
        box-sizing: border-box;
        transition: border-color 0.2s;
    }
    .field input:focus,
    .field textarea:focus {
        outline: none;
        border-color: #3498db;
    }
    .field .help {
        font-size: 0.78rem;
        color: #95a5a6;
        margin-top: 4px;
    }
    .field .errors {
        color: #c0392b;
        font-size: 0.8rem;
        margin-top: 4px;
    }
    .current-value {
        font-size: 0.78rem;
        color: #7f8c8d;
        margin-top: 4px;
        font-style: italic;
    }
    .form-actions {
        display: flex;
        gap: 12px;
        margin-top: 24px;
        flex-wrap: wrap;
    }
    .btn-submit {
        padding: 12px 28px;
        background: #3498db;
        color: white;
        border: none;
        border-radius: 8px;
        font-size: 0.95rem;
        font-weight: 700;
        cursor: pointer;
        font-family: inherit;
    }
    .btn-submit:hover { background: #2980b9; }
    .btn-cancel {
        padding: 12px 24px;
        color: #7f8c8d;
        text-decoration: none;
        font-size: 0.9rem;
        align-self: center;
    }
    .btn-cancel:hover { color: #2c3e50; }
</style>

<div class="req-wrap">
    <h1>💳 Solicitar cambio de datos bancarios</h1>

    <div class="alert-box">
        <strong>⚠️ Importante:</strong> Los datos bancarios están protegidos por seguridad.
        Tu solicitud será revisada por el administrador del marketplace y solo se aplicará
        después de su aprobación. Esto protege tu comercio contra cambios no autorizados.
    </div>

    <div class="form-card">
        <h2>Datos bancarios propuestos</h2>
        <p class="sub">
            Actualiza los campos que necesites cambiar. Los campos que no modifiques
            quedarán con el valor actual.
        </p>

        <form method="post">
            {% csrf_token %}

            {% if form.non_field_errors %}
                <div class="errors" style="padding: 12px; background: #fdedec; border-radius: 8px; margin-bottom: 16px;">
                    {{ form.non_field_errors }}
                </div>
            {% endif %}

            <div class="field">
                <label for="{{ form.new_bank_name.id_for_label }}">{{ form.new_bank_name.label }}</label>
                {{ form.new_bank_name }}
                {% if store.bank_name %}
                    <div class="current-value">Actual: {{ store.bank_name }}</div>
                {% endif %}
                {% if form.new_bank_name.errors %}<div class="errors">{{ form.new_bank_name.errors }}</div>{% endif %}
            </div>

            <div class="field">
                <label for="{{ form.new_account_number.id_for_label }}">{{ form.new_account_number.label }}</label>
                {{ form.new_account_number }}
                {% if store.account_number %}
                    <div class="current-value">Actual: {{ store.account_number }}</div>
                {% endif %}
                {% if form.new_account_number.errors %}<div class="errors">{{ form.new_account_number.errors }}</div>{% endif %}
            </div>

            <div class="field">
                <label for="{{ form.new_account_holder.id_for_label }}">{{ form.new_account_holder.label }}</label>
                {{ form.new_account_holder }}
                {% if store.account_holder %}
                    <div class="current-value">Actual: {{ store.account_holder }}</div>
                {% endif %}
                {% if form.new_account_holder.errors %}<div class="errors">{{ form.new_account_holder.errors }}</div>{% endif %}
            </div>

            <div class="field">
                <label for="{{ form.new_document.id_for_label }}">{{ form.new_document.label }}</label>
                {{ form.new_document }}
                {% if store.document %}
                    <div class="current-value">Actual: {{ store.document }}</div>
                {% endif %}
                {% if form.new_document.errors %}<div class="errors">{{ form.new_document.errors }}</div>{% endif %}
            </div>

            <h4 style="margin: 20px 0 10px; color: #2c3e50; font-size: 0.95rem; border-top: 1px solid #eee; padding-top: 14px;">
                📱 Datos de pago móvil
            </h4>

            <div class="field">
                <label for="{{ form.new_mobile_payment_bank.id_for_label }}">{{ form.new_mobile_payment_bank.label }}</label>
                {{ form.new_mobile_payment_bank }}
                {% if store.mobile_payment_bank %}
                    <div class="current-value">Actual: {{ store.mobile_payment_bank }}</div>
                {% endif %}
                <div class="help">Nombre del banco y código si quieres. Ej: "Banesco" o "Venezuela 0102".</div>
                {% if form.new_mobile_payment_bank.errors %}<div class="errors">{{ form.new_mobile_payment_bank.errors }}</div>{% endif %}
            </div>

            <div class="field">
                <label for="{{ form.new_mobile_document.id_for_label }}">{{ form.new_mobile_document.label }}</label>
                {{ form.new_mobile_document }}
                {% if store.mobile_document %}
                    <div class="current-value">Actual: {{ store.mobile_document }}</div>
                {% endif %}
                <div class="help">Cédula o RIF asociado al pago móvil.</div>
                {% if form.new_mobile_document.errors %}<div class="errors">{{ form.new_mobile_document.errors }}</div>{% endif %}
            </div>

            <div class="field">
                <label for="{{ form.new_payment_phone.id_for_label }}">{{ form.new_payment_phone.label }}</label>
                {{ form.new_payment_phone }}
                {% if store.payment_phone %}
                    <div class="current-value">Actual: {{ store.payment_phone }}</div>
                {% endif %}
                <div class="help">Número de teléfono asociado al pago móvil.</div>
                {% if form.new_payment_phone.errors %}<div class="errors">{{ form.new_payment_phone.errors }}</div>{% endif %}
            </div>

            <div class="field">
                <label for="{{ form.reason.id_for_label }}">{{ form.reason.label }}</label>
                {{ form.reason }}
                <div class="help">Explica al administrador por qué necesitas este cambio.</div>
                {% if form.reason.errors %}<div class="errors">{{ form.reason.errors }}</div>{% endif %}
            </div>

            <div class="form-actions">
                <button type="submit" class="btn-submit">📤 Enviar solicitud</button>
                <a href="{% url 'stores:store_edit' store.id %}" class="btn-cancel">Cancelar</a>
            </div>
        </form>
    </div>
</div>
{% endblock %}
