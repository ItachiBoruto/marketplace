<body>
    <header>
        <div class="container">
            <h1>🛒 Mi Marketplace</h1>
            <nav>
                <a href="/">🏠 Inicio</a>
                <a href="{% url 'cart:view' %}" class="header-cart-link"><span class="cart-icon-text">🛒 Carrito</span><span class="cart-count-badge" {% if not cart_count %}style="display:none;"{% endif %}>{{ cart_count|default:0 }}</span></a>
                <span style="color: rgba(255,255,255,0.7); margin: 0 10px;">👤 {{ user.username }}</span>
            </nav>
        </div>
    </header>

    <main>
        <div class="container">
            {% if messages %}
                <div class="messages" style="margin: 16px 0;">
                    {% for message in messages %}
                        <p class="message {{ message.tags }}">{{ message }}</p>
                    {% endfor %}
                </div>
            {% endif %}

            <form method="post" enctype="multipart/form-data" id="checkoutForm">
                {% csrf_token %}
                {% if store %}<input type="hidden" name="store_id" value="{{ store.id }}">{% endif %}

                <div class="checkout-wrapper">
                    <!-- ============ COLUMNA IZQUIERDA: RESUMEN + ENVIO + TOTALES ============ -->
                    <div class="checkout-card">
                        <h2>📦 Resumen del pedido</h2>

                        {% if store %}
                            <div style="background:#f0f7ff;padding:10px 14px;border-radius:8px;margin-bottom:14px;font-size:0.88rem;color:#1a1a2e;border:1px solid #d6eaf8;">
                                🏪 <strong>{{ store.name }}</strong>
                                <span style="font-size:0.78rem;color:#7f8c8d;display:block;margin-top:2px;">Este pedido es solo de este comercio</span>
                            </div>
                        {% endif %}

                        {% for item in items %}
                            <div class="order-item">
                                <div class="oi-left">
                                    <span class="oi-name">{{ item.product.name }}</span>
                                    <span class="oi-qty">×{{ item.quantity }}</span>
                                </div>
                                <div class="oi-right">
                                    <span class="oi-price">${{ item.price|floatformat:2 }}</span>
                                    <span class="oi-total">${{ item.get_total|floatformat:2 }}</span>
                                </div>
                            </div>
                        {% endfor %}

                        <!-- ============ GRID: ENVIO (izq) + TOTALES (der) ============ -->
                        <div class="checkout-two-col">

                            <!-- COLUMNA IZQUIERDA: ENVIO -->
                            <div class="checkout-col-left">
                                <h3 class="col-title">🚚 ¿Cómo quieres recibir tu pedido?</h3>

                                {% if not delivery_available and not pickup_available %}
                                    <div class="notice" style="background:#f8d7da;color:#842029;border-left-color:#dc3545;">
                                        🚫 El comercio no está disponible en este momento.
                                    </div>
                                {% elif not delivery_available %}
                                    <div class="notice">
                                        🕐 Delivery no disponible ahora
                                        {% if store_status.delivery.today_open and store_status.delivery.today_close %}
                                            · {{ store_status.delivery.today_open|time:'H:i' }} a {{ store_status.delivery.today_close|time:'H:i' }}
                                        {% endif %}
                                    </div>
                                {% elif not pickup_available %}
                                    <div class="notice">
                                        🕐 Retiro en tienda no disponible ahora
                                        {% if store_status.pickup.today_open and store_status.pickup.today_close %}
                                            · {{ store_status.pickup.today_open|time:'H:i' }} a {{ store_status.pickup.today_close|time:'H:i' }}
                                        {% endif %}
                                    </div>
                                {% endif %}

                                <div class="shipping-options">
                                    {% if pickup_available %}
                                    <label class="shipping-option">
                                        <input type="radio" name="shipping_method" value="pickup"
                                               {% if form.shipping_method.value != 'delivery' %}checked{% endif %}>
                                        <div class="box">
                                            <span class="icon-title">🏪 Retiro en tienda</span>
                                            <span class="fee free">Gratis</span>
                                        </div>
                                    </label>
                                    {% endif %}

                                    {% if delivery_available %}
                                    <label class="shipping-option">
                                        <input type="radio" name="shipping_method" value="delivery"
                                               {% if form.shipping_method.value == 'delivery' %}checked{% endif %}>
                                        <div class="box">
                                            <span class="icon-title">🛵 Delivery</span>
                                            <span class="fee">+${{ total_delivery_fee|floatformat:2 }}</span>
                                        </div>
                                    </label>
                                    {% endif %}
                                </div>

                                {% if form.shipping_method.errors %}
                                    <div class="form-errors" style="margin-top:6px;">{{ form.shipping_method.errors }}</div>
                                {% endif %}

                                <div class="delivery-address-block" id="deliveryAddressBlock">
                                    <div class="form-row" style="margin-bottom:0;">
                                        <label for="{{ form.delivery_address.id_for_label }}">
                                            📍 {{ form.delivery_address.label }}
                                        </label>
                                        {{ form.delivery_address }}
                                        {% if form.delivery_address.errors %}
                                            <div class="form-errors">{{ form.delivery_address.errors }}</div>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>

                            <!-- COLUMNA DERECHA: TOTALES -->
                            <div class="checkout-col-right">
                                <h3 class="col-title">💰 Total a pagar</h3>

                                <div class="totals-compact">
                                    <div class="tot-line">
                                        <span>Subtotal</span>
                                        <span>${{ subtotal|floatformat:2 }}</span>
                                    </div>
                                    <div class="tot-line" id="shippingLine" style="display:none;">
                                        <span>Envío</span>
                                        <span id="shippingFee">$0.00</span>
                                    </div>
                                    <div class="tot-line tot-grand">
                                        <span>Total USD</span>
                                        <span id="totalUsd">${{ subtotal|floatformat:2 }}</span>
                                    </div>
                                    {% if bcv_rate %}
                                    <div class="tot-line tot-bs">
                                        <span>Total Bs</span>
                                        <span id="totalBs">Bs. {{ subtotal|to_bs:bcv_rate }}</span>
                                    </div>
                                    <div class="tot-rate">
                                        Tasa BCV: <strong>{{ bcv_rate|floatformat:2 }} Bs/USD</strong>
                                    </div>
                                    {% endif %}
                                </div>
                            </div>

                        </div>

                        <a href="{% url 'cart:view' %}" class="btn-back">← Volver al carrito</a>
                    </div>

                    <!-- ============ COLUMNA DERECHA: DATOS BANCARIOS + PAGO ============ -->
                    <div class="checkout-card">
                        <h2>💳 Registrar tu pago</h2>

                        <!-- ============ SELECTOR DE METODO DE PAGO ============ -->
                        <div class="payment-methods-wrap">
                            <h3>💳 ¿Cómo quieres pagar?</h3>

                            <div class="payment-methods-row">
                                {% if accepts_transfer %}
                                <button type="button" class="pm-btn selected" data-method="transfer" id="pmBtnTransfer">
                                    <span class="pm-icon">🏦</span>
                                    <span class="pm-label">Transferencia</span>
                                </button>
                                {% endif %}
                                {% if accepts_mobile %}
                                <button type="button" class="pm-btn{% if not accepts_transfer %} selected{% endif %}" data-method="mobile" id="pmBtnMobile">
                                    <span class="pm-icon">📱</span>
                                    <span class="pm-label">Pago móvil</span>
                                </button>
                                {% endif %}
                            </div>
                        </div>

                        {# ============ PANEL: TRANSFERENCIA ============ #}
                        {% if accepts_transfer %}
                        <div class="pm-panel" id="pmPanelTransfer" data-method="transfer">
                            <h3>Datos para la transferencia</h3>
                            <div class="bank-row-copy">
                                <div class="bank-row"><strong>Banco:</strong><span>{{ bank_info.bank_name }}</span></div>
                                <button type="button" class="btn-copy" onclick="copyToClipboard('{{ bank_info.bank_name }}', this)">📋</button>
                            </div>
                            <div class="bank-row-copy">
                                <div class="bank-row"><strong>Titular:</strong><span>{{ bank_info.account_holder }}</span></div>
                                <button type="button" class="btn-copy" onclick="copyToClipboard('{{ bank_info.account_holder }}', this)">📋</button>
                            </div>
                            {% if bank_info.document %}
                            <div class="bank-row-copy">
                                <div class="bank-row"><strong>Cédula / RIF:</strong><span>{{ bank_info.document }}</span></div>
                                <button type="button" class="btn-copy" onclick="copyToClipboard('{{ bank_info.document }}', this)">📋</button>
                            </div>
                            {% endif %}
                            <div class="bank-row-copy">
                                <div class="bank-row"><strong>Cuenta:</strong><span>{{ bank_info.account_number }}</span></div>
                                <button type="button" class="btn-copy" onclick="copyToClipboard('{{ bank_info.account_number }}', this)">📋</button>
                            </div>

                            <div class="qr-section">
                                <img src="{% url 'orders:payment_qr' %}" alt="QR" class="qr-image">
                                <p class="qr-hint">Escanea para copiar los datos</p>
                            </div>

                            <button type="button" class="btn-copy-all" onclick="copyAllTransferData()">
                                📋 Copiar todos los datos
                            </button>
                        </div>
                        {% endif %}

                        {# ============ PANEL: PAGO MOVIL ============ #}
                        {% if accepts_mobile %}
                        <div class="pm-panel{% if not accepts_transfer %} show{% endif %}" id="pmPanelMobile" data-method="mobile">
                            <h3>Datos para el pago móvil</h3>
                            <div class="bank-row-copy">
                                <div class="bank-row"><strong>Banco receptor:</strong><span>{{ mobile_info.bank_name }}</span></div>
                                <button type="button" class="btn-copy" onclick="copyToClipboard('{{ mobile_info.bank_name }}', this)">📋</button>
                            </div>
                            <div class="bank-row-copy">
                                <div class="bank-row"><strong>Teléfono:</strong><span>{{ mobile_info.phone }}</span></div>
                                <button type="button" class="btn-copy" onclick="copyToClipboard('{{ mobile_info.phone }}', this)">📋</button>
                            </div>
                            {% if mobile_info.document %}
                            <div class="bank-row-copy">
                                <div class="bank-row"><strong>Cédula / RIF:</strong><span>{{ mobile_info.document }}</span></div>
                                <button type="button" class="btn-copy" onclick="copyToClipboard('{{ mobile_info.document }}', this)">📋</button>
                            </div>
                            {% endif %}

                            <button type="button" class="btn-copy-all" onclick="copyAllMobileData()">
                                📋 Copiar todos los datos
                            </button>
                        </div>
                        {% endif %}

                        {# Campo oculto con el metodo elegido #}
                        <input type="hidden" name="payment_method" id="paymentMethodInput" value="{% if accepts_transfer %}transfer{% elif accepts_mobile %}mobile{% endif %}">


                        <h3>💳 Datos del pago</h3>

                        {% for field in form %}
                            {% if field.name != 'shipping_method' and field.name != 'delivery_address' %}
                                <div class="form-row">
                                    <label for="{{ field.id_for_label }}">{{ field.label }}</label>
                                    {{ field }}
                                    {% if field.errors %}
                                        <div class="form-errors">
                                            {% for e in field.errors %}{{ e }}{% endfor %}
                                        </div>
                                    {% endif %}
                                </div>
                            {% endif %}
                        {% endfor %}

                        <button type="submit" class="btn-checkout">✅ Confirmar pedido</button>
                    </div>
                </div>
            </form>
        </div>
    </main>

    {{ subtotal|stringformat:"f"|json_script:"data-subtotal" }}
    {{ total_delivery_fee|stringformat:"f"|json_script:"data-shipping" }}
    {{ bcv_rate|default_if_none:""|stringformat:"s"|json_script:"data-rate" }}
    <script>
        const SUBTOTAL_USD = parseFloat(JSON.parse(document.getElementById('data-subtotal').textContent)) || 0;
        const SHIPPING_FEE = parseFloat(JSON.parse(document.getElementById('data-shipping').textContent)) || 0;
        const BCV_RATE_RAW = JSON.parse(document.getElementById('data-rate').textContent);
        const BCV_RATE = BCV_RATE_RAW ? parseFloat(BCV_RATE_RAW) : null;
        const DELIVERY_AVAILABLE = {% if delivery_available %}true{% else %}false{% endif %};

        function formatUsd(v) { return '$' + v.toFixed(2); }
        function formatBs(v) { return 'Bs. ' + v.toLocaleString('es-VE', {minimumFractionDigits: 2, maximumFractionDigits: 2}); }

        function updateTotals() {
            const method = document.querySelector('input[name="shipping_method"]:checked')?.value || 'pickup';
            const isDelivery = method === 'delivery' && DELIVERY_AVAILABLE;
            const fee = isDelivery ? SHIPPING_FEE : 0;
            const totalUsd = SUBTOTAL_USD + fee;

            document.getElementById('shippingLine').style.display = isDelivery ? 'flex' : 'none';
            document.getElementById('shippingFee').textContent = formatUsd(fee);
            document.getElementById('totalUsd').textContent = formatUsd(totalUsd);

            if (BCV_RATE) {
                document.getElementById('totalBs').textContent = formatBs(totalUsd * BCV_RATE);
            }

            document.getElementById('deliveryAddressBlock').classList.toggle('show', isDelivery);
        }

        document.querySelectorAll('input[name="shipping_method"]').forEach(r => {
            r.addEventListener('change', updateTotals);
        });

        updateTotals();

        function copyToClipboard(text, btn) {
            const done = () => {
                if (btn) {
                    const orig = btn.textContent;
                    btn.textContent = '✅';
                    setTimeout(() => { btn.textContent = orig; }, 1500);
                }
            };
            if (navigator.clipboard && window.isSecureContext) {
                navigator.clipboard.writeText(text).then(done).catch(() => { fallbackCopy(text); done(); });
            } else { fallbackCopy(text); done(); }
        }
        function fallbackCopy(text) {
            const ta = document.createElement('textarea');
            ta.value = text; ta.style.position = 'fixed'; ta.style.opacity = '0';
            document.body.appendChild(ta); ta.select();
            try { document.execCommand('copy'); } catch (e) {}
            document.body.removeChild(ta);
        }
        function copyAllBankData() {
            const data = [
                'Banco: {{ bank_info.bank_name }}',
                'Titular: {{ bank_info.account_holder }}',
                'Cédula: {{ bank_info.document }}',
                'Cuenta: {{ bank_info.account_number }}',
                'Teléfono: {{ bank_info.phone }}'
            ].join('\n');
            copyToClipboard(data, null);
            alert('Datos copiados');
        }
    </script>
    <script src="/static/js/email-verify-banner.js"></script>
</body>
</html>
