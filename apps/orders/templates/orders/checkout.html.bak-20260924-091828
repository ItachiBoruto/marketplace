{% load static %}
{% load exchange_filters %}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Finalizar compra - Mi Marketplace</title>
    {% include 'partials/_meta_tags.html' %}
    <link rel="stylesheet" href="{% static 'css/style.css' %}?v=9">
    <style>
        .checkout-wrapper {
            max-width: 1000px;
            margin: 24px auto;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            align-items: start;
        }
        .checkout-card {
            background: white;
            border-radius: 12px;
            padding: 24px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.08);
        }
        .checkout-card h2 {
            margin: 0 0 16px;
            font-size: 1.3rem;
            color: #1a1a2e;
        }
        .checkout-card h3 {
            margin: 20px 0 10px;
            font-size: 1rem;
            color: #444;
        }
        .order-item {
            display: flex;
            justify-content: space-between;
            padding: 10px 0;
            border-bottom: 1px solid #f0f0f0;
            font-size: 0.92rem;
        }
        .order-item:last-child { border-bottom: none; }
        .order-item .name { font-weight: 600; color: #2c3e50; }
        .order-item .store { font-size: 0.78rem; color: #7f8c8d; display: block; }
        .summary-line {
            display: flex;
            justify-content: space-between;
            padding: 8px 0;
            font-size: 0.92rem;
            color: #555;
        }
        .order-total {
            display: flex;
            justify-content: space-between;
            padding: 14px 0 0;
            margin-top: 10px;
            border-top: 2px solid #e94560;
            font-size: 1.3rem;
            font-weight: 700;
            color: #e94560;
        }
        .order-total-bs {
            display: flex;
            justify-content: space-between;
            padding: 6px 0 0;
            font-size: 1rem;
            color: #2c3e50;
        }
        .rate-note {
            font-size: 0.78rem;
            color: #7f8c8d;
            margin: 4px 0 0;
            text-align: right;
        }
        .bank-info {
            background: #f8f9fa;
            border-radius: 8px;
            padding: 16px;
            margin-bottom: 18px;
            border-left: 4px solid #e94560;
        }
        .bank-info h3 {
            margin: 0 0 10px !important;
            font-size: 1rem;
            color: #1a1a2e;
        }
        .bank-row-copy {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 8px;
            border-bottom: 1px solid #e9ecef;
            padding: 6px 0;
        }
        .bank-row-copy .bank-row {
            flex: 1;
            display: flex;
            justify-content: space-between;
            padding: 0;
        }
        .bank-row strong { color: #2c3e50; }
        .bank-row span { color: #555; }
        .btn-copy {
            background: #f0f2f5;
            border: 1px solid #dee2e6;
            border-radius: 6px;
            padding: 4px 10px;
            font-size: 0.85rem;
            cursor: pointer;
            flex-shrink: 0;
        }
        .btn-copy:hover { background: #e2e6ea; }
        .qr-section {
            text-align: center;
            margin: 16px 0 10px;
        }
        .qr-image {
            max-width: 180px;
            border: 1px solid #dee2e6;
            border-radius: 8px;
            padding: 6px;
            background: white;
        }
        .qr-hint {
            font-size: 0.78rem;
            color: #7f8c8d;
            margin: 6px 0 0;
        }
        .btn-copy-all {
            width: 100%;
            padding: 10px;
            background: #0f3460;
            color: white;
            border: none;
            border-radius: 8px;
            font-size: 0.9rem;
            font-weight: 600;
            cursor: pointer;
            margin-top: 6px;
        }
        .btn-copy-all:hover { background: #16213e; }

        /* ===== SELECTOR DE ENVIO ===== */
        .shipping-section {
            margin: 20px 0;
            padding: 16px;
            background: #f8f9fa;
            border-radius: 10px;
            border: 1px solid #e9ecef;
        }
        .shipping-section h3 {
            margin: 0 0 12px !important;
            font-size: 0.95rem;
            color: #1a1a2e;
        }
        .shipping-options {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 8px;
        }
        .shipping-option {
            display: block;
            cursor: pointer;
            position: relative;
        }
        .shipping-option input[type="radio"] {
            position: absolute;
            opacity: 0;
            pointer-events: none;
        }
        .shipping-option .box {
            display: flex;
            flex-direction: column;
            gap: 3px;
            padding: 12px;
            border: 2px solid #e1e5ea;
            border-radius: 10px;
            background: white;
            transition: all 0.2s;
        }
        .shipping-option .box:hover {
            border-color: #c8d1da;
        }
        .shipping-option .icon-title {
            font-weight: 700;
            color: #2c3e50;
            font-size: 0.88rem;
        }
        .shipping-option .subtitle {
            font-size: 0.72rem;
            color: #7f8c8d;
        }
        .shipping-option .fee {
            font-size: 0.85rem;
            font-weight: 700;
            color: #e94560;
            margin-top: 3px;
        }
        .shipping-option .fee.free {
            color: #2ecc71;
        }
        .shipping-option input[type="radio"]:checked + .box {
            border-color: #e94560;
            background: #fff5f7;
        }
        .notice {
            background: #fef5e7;
            color: #856404;
            padding: 8px 12px;
            border-radius: 6px;
            font-size: 0.78rem;
            margin-bottom: 10px;
            border-left: 3px solid #f39c12;
        }
        .delivery-address-block {
            display: none;
            margin-top: 12px;
        }
        .delivery-address-block.show { display: block; }

        /* ===== FORMULARIO DE PAGO ===== */
        .form-row { margin-bottom: 14px; }
        .form-row label {
            display: block;
            font-size: 0.83rem;
            font-weight: 600;
            color: #444;
            margin-bottom: 5px;
        }
        .form-control {
            width: 100%;
            padding: 10px 12px;
            border: 2px solid #e1e5ea;
            border-radius: 8px;
            font-size: 0.92rem;
            font-family: inherit;
            box-sizing: border-box;
        }
        .form-control:focus {
            outline: none;
            border-color: #e94560;
        }
        .form-errors {
            color: #c0392b;
            font-size: 0.8rem;
            margin-top: 3px;
        }
        .btn-checkout {
            width: 100%;
            padding: 14px;
            background: #28a745;
            color: white;
            border: none;
            border-radius: 8px;
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
            margin-top: 8px;
        }
        .btn-checkout:hover { background: #218838; }
        .btn-back {
            display: inline-block;
            margin-top: 10px;
            color: #6c757d;
            text-decoration: none;
            font-size: 0.9rem;
        }

        @media (max-width: 768px) {
            .checkout-wrapper { grid-template-columns: 1fr; }
            .shipping-options { grid-template-columns: 1fr; }
        }
    </style>
    <style>
        /* ============ METODOS DE PAGO - BOTONES Y PANELES ============ */
        .payment-methods-wrap {
            margin-bottom: 14px;
        }
        .payment-methods-wrap h3 {
            font-size: 1rem;
            color: #1a1a2e;
            margin: 0 0 10px;
            font-weight: 700;
        }
        .payment-methods-row {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
        }
        .pm-btn {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 2px;
            flex: 1 1 0;
            min-width: 90px;
            padding: 10px 8px;
            background: white;
            border: 2px solid #dfe3e8;
            border-radius: 10px;
            cursor: pointer;
            font-family: inherit;
            transition: border-color 0.2s, background 0.2s, transform 0.15s;
        }
        .pm-btn:hover {
            border-color: #e94560;
            transform: translateY(-1px);
        }
        .pm-btn.selected {
            border-color: #e94560;
            background: #fff5f7;
            box-shadow: 0 2px 8px rgba(233, 69, 96, 0.15);
        }
        .pm-btn .pm-icon {
            font-size: 1.4rem;
            line-height: 1;
        }
        .pm-btn .pm-label {
            font-size: 0.78rem;
            font-weight: 600;
            color: #2c3e50;
            text-align: center;
            line-height: 1.1;
        }
        .pm-btn.selected .pm-label {
            color: #c0392b;
        }
        .pm-panel {
            display: none;
            background: #f8f9fa;
            border-radius: 10px;
            padding: 14px;
            margin-bottom: 14px;
            border: 1px solid #e9ecef;
        }
        .pm-panel.show {
            display: block;
            animation: pmFadeIn 0.25s ease;
        }
        @keyframes pmFadeIn {
            from { opacity: 0; transform: translateY(-4px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .pm-panel h3 {
            font-size: 0.92rem;
            color: #1a1a2e;
            margin: 0 0 10px;
            font-weight: 700;
        }

        /* Mobile: los botones mas compactos */
        @media (max-width: 500px) {
            .pm-btn {
                padding: 8px 6px;
                min-width: 70px;
            }
            .pm-btn .pm-icon { font-size: 1.2rem; }
            .pm-btn .pm-label { font-size: 0.72rem; }
            .pm-panel { padding: 10px; }
        }
    </style>
